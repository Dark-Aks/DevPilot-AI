# DevPilot AI — Environment Variables
# Copy to .env and fill in values

# API authentication (used by ApiKeyMiddleware and token endpoint)
DEVPILOT_API_KEY=your-api-key-here

# OpenAI / Embedding provider
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1/embeddings

# GitHub integration
GITHUB_TOKEN=ghp_your-github-token
GITHUB_WEBHOOK_SECRET=your-webhook-hmac-secret

# ChromaDB vector store
CHROMA_HOST=localhost
CHROMA_PORT=8001

# CORS — comma-separated origins for production
CORS_ORIGINS=https://example.com,https://app.example.com

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# Cache provider: memory | redis
CACHE_PROVIDER=memory

# JWT authentication
JWT_SECRET=change-me-to-a-secure-secret-at-least-32-chars!
JWT_EXPIRY_MINUTES=60
JWT_ISSUER=DevPilotAI
JWT_AUDIENCE=DevPilotAI
